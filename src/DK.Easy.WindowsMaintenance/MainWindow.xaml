<Window x:Class="DK.Easy.WindowsMaintenance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Easy Windows System Maintenance Tool"
        Width="1080" Height="700" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F5F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#192638">
            <DockPanel Margin="16,26,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,4,24">
                    <TextBlock Text="DK Easy" FontWeight="Bold" FontSize="22"
                               Foreground="White" />
                    <TextBlock Text="Windows 시스템 점검"
                               Margin="0,6,0,0" Foreground="#C1CCDB" />
                </StackPanel>
                <ListBox x:Name="NavigationList"
                         SelectionChanged="NavigationList_SelectionChanged"
                         SelectedIndex="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,12" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="#EEF3FA" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="대시보드" />
                    <ListBoxItem Content="저장 공간" />
                    <ListBoxItem Content="시작 프로그램" />
                    <ListBoxItem Content="서비스" />
                    <ListBoxItem Content="예약 작업" />
                    <ListBoxItem Content="설치 프로그램" />
                    <ListBoxItem Content="점검 기록" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle"
                       Text="대시보드"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="#182638" Margin="0,0,0,24" />

            <Border Grid.Row="1" Background="White" CornerRadius="12"
                    BorderBrush="#DEE5EF" BorderThickness="1" Padding="28">
                <StackPanel>
                    <TextBlock Text="프로젝트 기본 화면"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="#243449" />
                    <TextBlock x:Name="PageDescription"
                               Margin="0,14,0,14"
                               Foreground="#536477" TextWrapping="Wrap" />
                    <TextBlock Text="현재는 메뉴 탐색만 구현되어 있습니다. 실제 검사 및 정리 기능은 개발 단계에 따라 추가합니다."
                               Foreground="#77869A" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
