<Window x:Class="DK.Easy.WindowsMaintenance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Easy Windows System Maintenance Tool" Icon="Assets/Maintenance.ico"
        Width="1120" Height="740" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="14"
        Background="#F2F6FA" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        StateChanged="Window_StateChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#14263B">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Margin="7,0,0,16" Orientation="Horizontal">
                    <Image Source="Assets/Maintenance.ico" Width="32" Height="32" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DK Easy" Foreground="White" FontWeight="Bold" FontSize="17" />
                        <TextBlock Text="Windows 시스템 점검" Foreground="#B7CADB" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Navigation_Changed">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#E6EFF7" />
                            <Setter Property="Padding" Value="11,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NavSurface" CornerRadius="7" Background="Transparent"
                                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavSurface" Property="Background" Value="#24415A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="NavSurface" Property="Background" Value="#235951" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#89CAC4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="dashboard" Content="대시보드" />
                    <ListBoxItem Tag="events" Content="시스템 문제" />
                    <ListBoxItem Tag="storage" Content="저장 공간" />
                    <ListBoxItem Tag="startup" Content="시작 프로그램" />
                    <ListBoxItem Tag="services" Content="서비스" />
                    <ListBoxItem Tag="tasks" Content="예약 작업" />
                    <ListBoxItem Tag="apps" Content="설치 프로그램" />
                    <ListBoxItem Tag="history" Content="점검 기록" />
                    <ListBoxItem Tag="settings" Content="설정" />
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="23,17,23,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Content="전체 검사" Click="Scan_Click" VerticalAlignment="Center" />
                <TextBlock x:Name="PageTitle" Text="대시보드" FontSize="27" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="시스템 정보" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ComputerText" Text="미검사" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="WindowsText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DriveHeading" Text="시스템 드라이브" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="DriveSpace" Text="미검사" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="DriveUsage" Margin="0,9,0,0" Height="7" Maximum="100"
                                         Foreground="{StaticResource Accent}" Visibility="Collapsed"
                                         AutomationProperties.Name="시스템 드라이브 사용률" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
                        <Expander Header="검사 범위 및 마지막 검사">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="전체 검사는 선택 드라이브, 시스템 문제, 시작 프로그램, 서비스, 예약 작업, 설치 앱을 조회하고 기록을 저장합니다."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock x:Name="LastScanText" Text="마지막 검사 · 미검사" Margin="0,6,0,0" />
                                <TextBlock x:Name="OverviewCounts" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="EventsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,9">
                    <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="내보내기" Click="Export_Click"
                            IsEnabled="False" VerticalAlignment="Top" Margin="8,0,0,0" />
                    <TextBlock x:Name="EventSummary" Text="미검사 · Windows 시스템·응용 프로그램 로그의 심각 및 오류 이벤트"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid x:Name="EventsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Event_Changed"
                          RowHeight="33" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E6EDF3" Background="White" BorderBrush="#DCE5ED"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="시스템 이벤트 목록">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="발생 시각" Binding="{Binding DisplayTime}" Width="158" />
                        <DataGridTextColumn Header="수준" Binding="{Binding Severity}" Width="62" />
                        <DataGridTextColumn Header="원본" Binding="{Binding Provider}" Width="*" MinWidth="135" />
                        <DataGridTextColumn Header="이벤트 ID" Binding="{Binding EventId}" Width="82" />
                    </DataGrid.Columns>
                </DataGrid>
                <Expander x:Name="EventDetails" Grid.Row="2" Header="이벤트 상세" Margin="0,8,0,0" IsEnabled="False">
                    <TextBox x:Name="EventMessage" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Padding="8" Margin="0,6,0,0" AutomationProperties.Name="선택한 이벤트 설명" />
                </Expander>
            </Grid>
            <Grid x:Name="InventoryPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <WrapPanel>
                        <ComboBox x:Name="DriveSelect" Width="104" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="검사할 드라이브" SelectionChanged="Drive_Changed" />
                        <Button x:Name="InspectPageButton" Content="이 화면 검사" Click="InspectPage_Click" Margin="0,0,8,0" />
                        <Button x:Name="OpenLocationButton" Content="위치 열기" Click="OpenLocation_Click" Margin="0,0,8,0" />
                        <Button x:Name="ManageButton" Content="선택 항목 관리" Click="Manage_Click" Margin="0,0,8,0" />
                        <CheckBox x:Name="FilterSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    </WrapPanel>
                    <TextBlock x:Name="InventorySummary" Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid x:Name="InventoryGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          SelectionChanged="InventorySelection_Changed" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E6EDF3" Background="White" BorderBrush="#DCE5ED"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="점검 결과 목록" />
                <Expander x:Name="InventoryDetails" Grid.Row="2" Header="선택 항목 상세" Margin="0,8,0,0">
                    <TextBox x:Name="InventoryDetailText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130"
                             VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,6,0,0" />
                </Expander>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="창 및 트레이" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Label Content="창 닫기 동작" Target="{Binding ElementName=CloseSetting}" VerticalAlignment="Center" />
                                <ComboBox x:Name="CloseSetting" Width="145" Margin="10,0,0,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="매번 확인" />
                                    <ComboBoxItem Content="트레이로 숨기기" />
                                    <ComboBoxItem Content="프로그램 종료" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="MinimizeSetting" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                      Content="최소화할 때 트레이로 숨기기" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="검사" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <CheckBox x:Name="LaunchSetting" Style="{StaticResource Switch}" Content="앱을 열 때 전체 검사" />
                            <CheckBox x:Name="WarningSetting" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                      Content="시스템 문제에 경고 이벤트 포함" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Label Content="이벤트 조회 기간" Target="{Binding ElementName=DaysSetting}" VerticalAlignment="Center" />
                                <ComboBox x:Name="DaysSetting" Width="95" Margin="10,0,0,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="1일" />
                                    <ComboBoxItem Content="7일" />
                                    <ComboBoxItem Content="14일" />
                                    <ComboBoxItem Content="30일" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="저장 공간" FontSize="18" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,10,0,0">
                                <Label Content="큰 파일 (GiB)" Target="{Binding ElementName=FileThreshold}" />
                                <TextBox x:Name="FileThreshold" Width="55" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                                <Label Content="큰 폴더 (GiB)" Target="{Binding ElementName=FolderThreshold}" />
                                <TextBox x:Name="FolderThreshold" Width="55" VerticalContentAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="설정 저장" Click="SaveSettings_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#E7EEF4" CornerRadius="8" Padding="11,6" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="미검사" VerticalAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="ScanProgress" Grid.Column="1" Height="6" Margin="8,0,0,0" Maximum="2"
                                 Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                 AutomationProperties.Name="전체 검사 진행률" />
                    <Button x:Name="CancelScanButton" Grid.Column="2" Content="취소" Click="CancelScan_Click"
                            Visibility="Collapsed" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
